class Solution {
    public static long[] productExceptSelf(int a[]) {
        int n = a.length;
        long[] pf = new long[n];
        long[] sf = new long[n];
        
        pf[0] = a[0];
        for(int i = 1; i < n; i++) pf[i] = pf[i - 1] * a[i];
        
        
        sf[n - 1] = a[n - 1];
        for(int i = n - 2; i >= 0; i--) sf[i] = sf[i + 1] * a[i];
        
        
        long[] ans = new long[n]; Arrays.fill(ans, 1); //IMP
        for(int i = 0; i < n; i++) {
            if(i - 1 >= 0) ans[i] *= pf[i - 1];
            if(i + 1 < n) ans[i] *= sf[i + 1];
        }
        return ans;
    }
}
