class Solution {
    public long multiplyTwoLists(Node first, Node second) {
    
        long m = 1000000007;
        long n1 = 0, n2 = 0;
      
        while (first != null || second != null) {
            if (first != null) {
                n1 = ((n1 * 10) + first.data) % m;
                first = first.next;
            }
          
            // Traverse the second list and 
              // construct the number with modulo
            if (second != null) {
                n2 = ((n2 * 10) + second.data) % m;
                second = second.next;
            }
        }
      
          // Return the product of the two 
          // numbers with modulo
        return (n1 * n2) % m; 
    }
}
