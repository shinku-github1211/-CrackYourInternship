class Solution {
    // Function to find if there is a celebrity in the party or not.
    public int celebrity(int mat[][]) {
 int n = mat.length;

        // Step 1: Find the potential celebrity (someone who doesn't know anyone)
        int potentialCelebrity = -1;
        for (int i = 0; i < n; i++) {
            boolean knowsSomeone = false;
            for (int j = 0; j < n; j++) {
                if (mat[i][j] == 1) {
                    knowsSomeone = true; // This person knows someone, so not a celebrity
                    break;
                }
            }
            if (!knowsSomeone) {
                potentialCelebrity = i; // This person could be the celebrity
                break;
            }
        }

        // If no potential celebrity found, return -1
        if (potentialCelebrity == -1) {
            return -1;
        }

        // Step 2: Check if everyone else knows the potential celebrity
        for (int i = 0; i < n; i++) {
            if (i != potentialCelebrity && (mat[i][potentialCelebrity] == 0 || mat[potentialCelebrity][i] == 1)) {
                return -1; // This person is either not known by everyone or knows someone else
            }
        }

        // If all conditions are satisfied, return the potential celebrity
        return potentialCelebrity;
    
    }
}
