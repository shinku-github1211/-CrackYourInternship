class Solution
{
    //Function to evaluate a postfix expression.
    public static int evaluatePostFix(String S)
    {
        // Your code here
        Stack<Integer> stack=new Stack<>();
        for(int i=0; i<S.length(); i++) {
            int ch=S.charAt(i);
            
            if(Character.isDigit(ch)) {
                stack.push(ch-'0');
            }
            
            else {
                
               int val2=stack.pop();
                int val1=stack.pop();
                switch(ch){
                    case '+':
                        stack.push(val1+val2);
                        break;
                     case '-':
                        stack.push(val1-val2);
                        break;
                     case '*':
                        stack.push(val1*val2);
                        break;
                     case '/':
                        stack.push(val1/val2);
                        break;
                }
                
            }
        }
        
        return stack.peek();
    }
}
