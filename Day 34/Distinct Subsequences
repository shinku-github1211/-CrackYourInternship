class Solution {
    public int numDistinct(String s, String t) {
        int m=s.length(),n=t.length();
        int curr[]=new int[n+1];
        int prev[]=new int[n+1];
        prev[0]=1;
        curr[0]=1;
        for(int i=1;i<=m;i++){
            for(int j=1;j<=n;j++){
                if(s.charAt(i-1)==t.charAt(j-1))
                   curr[j]= prev[j-1]+ prev[j];
                else 
                    curr[j] = prev[j];
            }
            prev=(int[])curr.clone();
        }
        return prev[n];
    }
}
