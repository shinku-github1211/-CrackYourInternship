//User function Template for Java


class Solution
{
    
    public class pair{
        int src;
        int des;
        
        public pair(int src,int des){
            this.src=src;
            this.des=des;
        }
    }
    public  void dfs(ArrayList<pair>graph[],int curr,Stack<Integer>stack
    ,boolean visit[],boolean from_stack){
        
        visit[curr]=true;
        
        for(int i=0;i<graph[curr].size();i++){
            int des = graph[curr].get(i).des;
            
            if(!visit[des]){
                dfs(graph,des,stack,visit,from_stack);
            }
        }
        
        if(!from_stack)
        stack.push(curr);
        
    }
    //Function to find number of strongly connected components in the graph.
    public int kosaraju(int V, ArrayList<ArrayList<Integer>> adj)
    {
        //code here
        
        ArrayList<pair>graph[]  = new ArrayList[V];
        
        for(int i=0;i<V;i++){
            graph[i]= new ArrayList<>();
        }
        
        for(int i=0;i<V;i++){
            for(int j=0;j<adj.get(i).size();j++){
                int src=i;
                int des= adj.get(i).get(j);
                graph[src].add(new pair(src,des));
            }
        }
        Stack<Integer>stack = new Stack<>();
        boolean visit[] = new boolean [V];
        
        for(int i=0;i<V;i++){
            if(!visit[i]){
                dfs(graph,i,stack,visit,false);
            }
        }
        
        ArrayList<pair>graph2[] = new ArrayList[V];
        for(int i=0;i<V;i++){
            graph2[i]= new ArrayList<>();
        }
        
        for(int i=0;i<V;i++){
            for(int j=0;j<graph[i].size();j++){
                int src = graph[i].get(j).src;
                int des = graph[i].get(j).des;
                
                graph2[des].add(new pair(des,src));
            }
        }
        
        
        
        Arrays.fill(visit,false);
        int count=0;
        
        while(!stack.isEmpty()){
            int curr=stack.pop();
            
            if(!visit[curr]){
                count++;
                dfs(graph2,curr,null,visit,true);
            }
        }
        
        return count;
        
    }
}
