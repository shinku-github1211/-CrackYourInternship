class Solution
{
    //Function to return list containing vertices in Topological order. 
    static int[] topoSort(int V, ArrayList<ArrayList<Integer>> adj) 
    {
        // add your code here
        Stack<Integer> s=new Stack<>();
        boolean[] vis=new boolean[V];
        for(int i=0;i<V;i++) {
            if(!vis[i]) {
                dfs(i,adj,vis,s);
            }
        }
        int[] ans=new int[V];
        int i=0;
        while(!s.isEmpty()) {
            ans[i++]=s.pop();
        }
        return ans;
    }
    static void dfs(int i, ArrayList<ArrayList<Integer>> adj, boolean[] vis, Stack<Integer> s) {
        vis[i]=true;
        for(int j=0;j<adj.get(i).size();j++) {
            int y=adj.get(i).get(j);
            if(!vis[y]) {
                dfs(y,adj,vis,s);
            }
        }
        s.push(i);
    }
}
